{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "catalog/**" }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 7 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }] }
  ]
}
