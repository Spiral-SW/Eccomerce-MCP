# Configure localmente, sem enviar tokens ao chat.
# Logs JSONL locais em OLLYX_DATA_DIR/logs; 0 desliga o registro de consultas.
OLLYX_API_LOG=1
BLING_ACCESS_TOKEN=
MELI_ACCESS_TOKEN=
# Arquivos OAuth exclusivos do MCP; não copie refresh tokens de outro sistema.
BLING_TOKEN_FILE=secrets/bling.json
MELI_TOKEN_FILE=secrets/meli.json
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
# Alternativa: ler access tokens do banco da Ollyx, sem renová-los ou alterá-los.
OLLYX_DATABASE_URL=
BLING_USE_OLLYX_DATABASE=false
MELI_USE_OLLYX_DATABASE=false
OLLYX_TIMEOUT_MS=20000
OLLYX_MAX_RESPONSE_BYTES=2097152

# Alternativa: conexão existente em outro projeto, lida a cada chamada, sem refresh.
BLING_SHARED_ENV_FILE=
MELI_SHARED_ENV_FILE=
